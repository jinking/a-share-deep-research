{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jinking/a-share-deep-research/schemas/claim.schema.json",
  "title": "Claim",
  "description": "可追溯研究结论（evidence/claims.jsonl 的一行）",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "claim"],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "推荐语义稳定 ID，如 C_FIN_REV_2026H1 / C_ORDER_224G_STATUS，而不是 C001"
    },
    "claim": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "financial",
        "order",
        "customer",
        "industry",
        "valuation",
        "governance",
        "risk",
        "market",
        "other"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "fact",
        "management_statement",
        "inference",
        "assumption",
        "unconfirmed",
        "third_party_consensus",
        "confirmed_revenue",
        "confirmed_order",
        "design_win",
        "mass_production",
        "batch_delivery"
      ]
    },
    "materiality": {
      "type": "string",
      "enum": ["critical", "major", "normal"],
      "description": "只有 critical / major 进入严格 Evidence Validation"
    },
    "status": {
      "type": "string",
      "enum": ["supported", "partially_supported", "unsupported", "pending", "contradicted"]
    },
    "scope": {
      "type": "string",
      "enum": ["report", "internal"],
      "default": "report",
      "description": "report（默认，面向交付报告，critical/major 必须进入 manifest.evidence_refs）/ internal（内部中间结论，可不进）。确有内部 Claim 时显式标 internal，不要靠删 manifest 隐藏（v3.0.3 §8）"
    },
    "requires_two_sources": {
      "type": "boolean",
      "description": "置 true 时校验独立来源数 >= 2（同 source_group 的转载只算一个）"
    },
    "basis_claim_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "v3.1 Forecast Lineage 预留：假设型 Claim 所依据的事实 Claim"
    },
    "migration_status": { "type": ["string", "null"] },
    "note": { "type": ["string", "null"] }
  }
}
