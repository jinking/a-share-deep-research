# === 运行时二进制 ===
# westock Go CLI 体积 8.6MB 且可复现获取，不入库。
# 需要时执行：bash scripts/install_westock_cli.sh
tools/bin/*
!tools/bin/.gitkeep

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.pytest-tmp/

# === 本地凭证（永不入库）===
.env
.env.*
*.key
*.pem
*credential*
*token*.json
!assets/research_manifest.template.json

# === 运行产物 ===
# fetch_stock.py 的取数输出目录（research_<code>/raw/）不入库。
# ⚠️ 不要写成裸 `raw/`：那会把证据原件 examples/**/evidence/raw/ 一并排除，
#    导致他人在 clone 后跑证据校验直接报 EVIDENCE_DOC_MISSING(P0)——证据链断裂。
research_*/raw/
/raw/
*.log

# === macOS / 编辑器 ===
.DS_Store
Thumbs.db
.idea/
.vscode/
